# ---- collector ----
PORT=8080
DATABASE_URL=postgres://cinehost:cinehost@localhost:5433/cinehost

# Only read by docker-compose, to name the Postgres role and database it
# creates on first boot. They are baked into the volume at that moment and
# cannot be changed later by editing this file - an existing install must keep
# whatever it was first initialised with.
POSTGRES_USER=cinehost
POSTGRES_DB=cinehost
POSTGRES_PASSWORD=change_me

# Public origin this service is reachable at (used to build embed + asset URLs)
PUBLIC_BASE_URL=http://localhost:8080

# Public, shipped in page source. Identifies your install, not a secret.
INGEST_SITE_KEY=pk_dev_change_me

# Private. Server-to-server calls (video CRUD, identify, stats).
SERVER_API_KEY=sk_dev_change_me

# HTTP Basic creds for the /app dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me

# Origins allowed to POST beacons + iframe the embed. Comma separated.
# Supports a leading wildcard label: https://*.example.com
ALLOWED_ORIGINS=http://localhost:3000,https://example.com,https://*.example.com

# ---- outbound webhooks (fire into your own application) ----
WEBHOOK_URL=
WEBHOOK_SECRET=
# Percent watched marks that fire view.threshold
WEBHOOK_THRESHOLDS=25,50,75,90
# Only set this if bot mitigation in front of your receiver needs a specific
# string to allow-list. Deliveries are a plain server-to-server POST, which
# Cloudflare Bot Fight Mode and friends challenge by default.
# WEBHOOK_USER_AGENT=

# ---- upload + transcode ----
# Where uploaded originals and ffmpeg scratch live. In Docker these are inside
# the `uploads` volume so an encode survives a restart.
UPLOAD_DIR=/data/uploads
WORK_DIR=/data/work
MAX_UPLOAD_BYTES=5368709120
# Keep some cores free if the box runs anything else.
FFMPEG_THREADS=3
FFMPEG_CRF=21
FFMPEG_PRESET=medium

# ---- Cloudflare cache purge (optional) ----
# Media is served `immutable` for a year, so deleting an object from R2 does
# NOT stop the edge serving it. A token with Zone > Cache Purge makes a purge
# actually retract the file; without it the API says so instead of pretending.
CF_ZONE_ID=
CF_PURGE_TOKEN=

# ---- R2 (required on the server: the transcoder uploads the finished mp4) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=my-video-bucket
# Custom domain bound to the bucket. NEVER the *.r2.dev URL - it is
# rate limited and not cached at the edge.
MEDIA_BASE_URL=https://video.example.com
