{
  "name": "@cinehost/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CineHost collector: beacon ingest, video registry, transcode pipeline, stats API and dashboard.",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file=../../.env src/index.js",
    "start": "node src/index.js",
    "build:css": "tailwindcss -i src/dashboard.css -o public/app/app.css --minify",
    "dev:css": "tailwindcss -i src/dashboard.css -o public/app/app.css --watch"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "@aws-sdk/client-s3": "^3.1109.0"
  },
  "devDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
